<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      CRITICAL FOR MCP STDIO TRANSPORT:
      All application logs MUST be routed to System.err so System.out
      remains 100% clean for JSON-RPC 2.0 protocol messages.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>

    <!-- Suppress verbose internal framework logs -->
    <logger name="org.springframework" level="WARN" />
    <logger name="com.zaxxer.hikari" level="INFO" />
    <logger name="com.example.mysqlmcp" level="INFO" />
</configuration>
